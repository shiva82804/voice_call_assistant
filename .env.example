# ==============================================================================
# Voice Call Assistant - Environment Configuration
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Target Lead / Testing Phone Number
TARGET_PHONE_NUMBER=+918790513762
# Final Evaluator Number (when ready to make the live submission call)
# TARGET_PHONE_NUMBER=+918688664337

# Candidate Details (Appears in follow-up WhatsApp & Resume dispatch)
CANDIDATE_NAME="Your Name"
CANDIDATE_PHONE="+918790513762"
CANDIDATE_RESUME_PATH="assets/resume.pdf"

# ------------------------------------------------------------------------------
# 1. Voice AI & Telephony (Vapi.ai Recommended)
# Sign up at https://vapi.ai (provides free initial credits)
# ------------------------------------------------------------------------------
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Optional: If using OpenAI directly for custom LLM orchestration
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. WhatsApp Delivery Service
# Choose one of: twilio, meta, or mock
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=twilio

# If using Twilio WhatsApp Sandbox (Easiest to start):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# If using Meta WhatsApp Cloud API:
META_WHATSAPP_TOKEN=your_meta_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# ------------------------------------------------------------------------------
# 3. Webhook Server Configuration
# ------------------------------------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# Your public URL for webhooks (e.g. ngrok: https://xxxx.ngrok-free.app)
PUBLIC_WEBHOOK_URL=http://localhost:8000
